# Copia este archivo a api/.env solo en tu máquina local y reemplaza el valor
# por tu propia clave de Groq. Nunca subas api/.env al repositorio.

# Clave de API de Groq, leída solo por el servidor (api/). Obtenla desde la
# consola de Groq; no la pegues en el frontend ni en el código.
GROQ_API_KEY=FAKE_GROQ_KEY_DO_NOT_USE

# Nombre del modelo de Groq que usará el chat en un día posterior.
GROQ_MODEL=FAKE_MODEL_NOT_CONFIGURED